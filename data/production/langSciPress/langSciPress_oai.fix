# metadata.oai_dc:dc.dc:publisher.value
# metadata.oai_dc:dc.dc:publisher.xml:lang
# metadata.oai_dc:dc.dc:relation.*.value
# metadata.oai_dc:dc.dc:relation.value
# metadata.oai_dc:dc.dc:source.value
# metadata.oai_dc:dc.dc:source.xml:lang
# metadata.oai_dc:dc.dc:subject.*.value
