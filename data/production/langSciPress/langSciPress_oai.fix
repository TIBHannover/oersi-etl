# metadata.oai_dc:dc.dc:creator.value
# metadata.oai_dc:dc.dc:creator.xml:lang
# metadata.oai_dc:dc.dc:date.value
# metadata.oai_dc:dc.dc:description.*.value
# metadata.oai_dc:dc.dc:description.*.xml:lang
# metadata.oai_dc:dc.dc:description.value
# metadata.oai_dc:dc.dc:description.xml:lang
# metadata.oai_dc:dc.dc:format.value
