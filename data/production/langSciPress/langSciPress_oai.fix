# Reject deleted, broken, unsufficient records

if exists ("metadata.error")
  reject()
end

if any_equal ("header.status", "deleted")
  reject()
end

# --------Delete all emtpy values-------
vacuum()

# #header.datestamp.value
# header.identifier.value
# header.setSpec.value
# header.status
# metadata.oai_dc:dc.dc:coverage.*.xml:lang
# metadata.oai_dc:dc.dc:coverage.value
# metadata.oai_dc:dc.dc:coverage.xml:lang
# metadata.oai_dc:dc.dc:creator.*.value
# metadata.oai_dc:dc.dc:creator.*.xml:lang
# metadata.oai_dc:dc.dc:creator.value
# metadata.oai_dc:dc.dc:creator.xml:lang
# metadata.oai_dc:dc.dc:date.value
# metadata.oai_dc:dc.dc:description.*.value
# metadata.oai_dc:dc.dc:description.*.xml:lang
# metadata.oai_dc:dc.dc:description.value
# metadata.oai_dc:dc.dc:description.xml:lang
# metadata.oai_dc:dc.dc:format.value
